# Required — Smartlead core API (server.smartlead.ai)
SMARTLEAD_API_KEY=

# Optional — if different from SMARTLEAD_API_KEY (otherwise same key is used)
SMARTDELIVERY_API_KEY=

# Slack alerts — use either an incoming webhook OR a bot token + channel id
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Optional label shown in messages (defaults to channel id / #deliverability)
SLACK_CHANNEL=#deliverability

# InboxKit — used to cancel mailboxes + remove blacklisted domains
INBOXKIT_API_KEY=
# Optional; auto-resolved from GET /workspaces if empty
INBOXKIT_WORKSPACE_ID=
# Dedicated workspace for the 75 generic recovery-pool mailboxes
GENERIC_POOL_WORKSPACE_ID=81e7f800-4203-4892-a40d-18648b89b90c

# Self-advancing pool pipeline (polls every 30m by default)
ENABLE_POOL_PROVISIONER=true
CRON_POOL_PROVISION=*/30 * * * *

# Approval gateway: when true (default), the pool provisioner will NOT spend
# InboxKit wallet balance on mailboxes automatically. Each purchase batch is
# held as "pending" and Slack-notified; a human must call
# POST /approvals/:id/approve (or GET /approvals to see what's pending)
# before the spend executes. Do not set false unless unattended spend is
# acceptable.
REQUIRE_SPEND_APPROVAL=true
# One-time InboxKit→Smartlead login (NOT the API key) — or connect Smartlead in InboxKit UI
SMARTLEAD_LOGIN_EMAIL=
SMARTLEAD_LOGIN_PASSWORD=

# Daily reconnect of disconnected Smartlead accounts (SMTP/IMAP fail → POST /reauth)
# Cron is evaluated in America/New_York so 3:00 tracks EST/EDT automatically
ENABLE_ACCOUNT_RECONNECT=true
CRON_ACCOUNT_RECONNECT=0 3 * * *

# Pull under-warmed (<14d) and active HOLD-UNTIL-* mailboxes off ACTIVE campaigns
# Runs automatically with the monitor cron (every 6h)
ENABLE_WARMUP_GATE=true
MIN_CAMPAIGN_WARMUP_DAYS=14

# Porkbun — parent-account domain buys for blacklist replace / pool domains
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# Total SmartDelivery placement-test quota (default 120)
TOTAL_TEST_QUOTA=120

# Max sender mailboxes per placement test (SmartDelivery limit is 50)
MAX_MAILBOXES_PER_TEST=50

# Create RECURRING (automated) placement tests instead of one-off manual tests,
# so a campaign keeps being tested for as long as it is live.
AUTO_PLACEMENT_TESTS=true
# How often a recurring test re-runs (1 = daily, so you can track inbox rate day over day)
PLACEMENT_TEST_EVERY_DAYS=1
# Optional hard stop, in days from creation. 0 = open-ended (recommended —
# the reconciler stops the test when the campaign goes inactive).
PLACEMENT_TEST_END_DAYS=0
# Campaign statuses that keep a recurring test running. A test whose campaign
# leaves this set gets stopped so it stops consuming test runs.
AUTO_TEST_ACTIVE_STATUSES=ACTIVE
# Stop recurring tests whose campaign is no longer active (runs with monitor cron)
ENABLE_TEST_RECONCILER=true

# Inbox placement alert threshold (percent). Alert when below this.
DELIVERABILITY_THRESHOLD=90

# Auto-remediation: pull non-blacklisted inboxes below this % off campaigns + warmup
REMEDIATION_INBOX_THRESHOLD=80
# D32: placement rotation uses same-ESP % only — never the blended all-ESP score
SCORE_SAME_ESP_ONLY=true
MIN_SAME_ESP_SAMPLES=3
# Set true to actually delete blacklisted domains / remove low inboxes (default false)
ENABLE_REMEDIATION=false
# Days to hold recovered inboxes off campaigns (Smartlead tag HOLD-UNTIL-YYYY-MM-DD)
# 14 = the 2-week warmup before a pulled inbox may go back on campaigns
RECOVERY_HOLD_DAYS=14
# Independent bounce rotation signal (requires remediation to run)
ENABLE_BOUNCE_ROTATION=true
BOUNCE_RATE_THRESHOLD=5
# PAUSED campaign aggregate sender bounce → investigate (D29); copy defers rotation
CAMPAIGN_BOUNCE_INVESTIGATE_THRESHOLD=7
MIN_BOUNCE_SAMPLE=50

# Keep every ACTIVE campaign at 50 *staffable* senders (connected + inboxing)
ENABLE_CAMPAIGN_TOP_UP=true
MIN_CAMPAIGN_SENDERS=50
# Fast staffing loop: reconnect → mailbox settings → refill/unpause (D25)
ENABLE_CAMPAIGN_HEALTH=true
CRON_HEALTH=*/15 * * * *
# Comma-separated exact ids or name fragments to leave untouched
TOP_UP_EXCLUDE_CAMPAIGNS=

# Fleet settings: Message Per Day (warmups not included) = 30 (D11/D24).
# Minimum time gap between sends = 10 minutes (D30). Two-line signatures (D31).
ENFORCE_MAILBOX_SETTINGS=true
MESSAGE_PER_DAY=30
MAILBOX_MIN_TIME_GAP_MINS=10

# PRE-WARMED generic mailboxes outside the .info pool plan, matched in Smartlead
# by email address OR by from_name. Comma-separated.
# These are registered as swap-ready generics immediately AND exempted from the
# warmup gate, so they stay on live campaigns instead of being pulled for
# "under-warmed" based on Smartlead's warmup start date.
EXTRA_GENERIC_MAILBOXES=harmony norris,breanna escobar
# Entire hand-bought fleets that were already warm before app management
EXTRA_GENERIC_DOMAINS=crosslaunchco.com,crossscaleco.com,cleartechco.com

# Recovery pool: swap warmed generics into campaigns while originals recover
ENABLE_RECOVERY_POOL=false
# Smartlead-only warmup days before a generic is free for swaps
POOL_WARMUP_DAYS=14
# Hard per-client monthly caps (UTC month) enforced by the spend gateway
CLIENT_DOMAIN_BUDGET_USD=25
CLIENT_MAILBOX_MONTHLY_CAP=25

# Warmup settings applied to recovered inboxes
WARMUP_TOTAL_PER_DAY=20
WARMUP_DAILY_RAMPUP=5
WARMUP_REPLY_RATE_PERCENTAGE=30

# Campaign statuses to consider for new tests (comma-separated)
CAMPAIGN_STATUSES=ACTIVE,PAUSED

# Cron: twice weekly Mon & Thu 09:00 UTC
CRON_SCAN=0 9 * * 1,4

# Cron: measure loop — placement results, remediation, warmup gate, DNS (slow)
CRON_MONITOR=0 */6 * * *

# Optional: comma-separated integer seed provider IDs.
# If empty, the app fetches providers from SmartDelivery and uses all available IDs.
PROVIDER_IDS=

# Optional: which sequence step to test (1 = first email). Default 1.
SEQUENCE_NUMBER=1

# Persist state here (mount a Railway volume at /data in production)
STATE_FILE_PATH=/data/state.json

# HTTP
PORT=3000
HOST=0.0.0.0

# Required shared secret for /status, /run and /approvals/*.
# Sensitive routes stay disabled until this is set; pass X-Run-Token.
RUN_TOKEN=

# Private employee console at /ops. Generate independent random values (32+
# characters); do not reuse RUN_TOKEN or share Josh's owner key with Cayden.
OPS_UI_ENABLED=true
OPS_OWNER_USERNAME=josh
OPS_OPERATOR_USERNAME=cayden
OPS_OWNER_TOKEN=
OPS_OPERATOR_TOKEN=
OPS_SESSION_SECRET=
OPS_SESSION_HOURS=12

# Freeform /ops chat → Cursor Cloud Agent (Grok 4.5 High Fast).
# Create a key at https://cursor.com/dashboard/api — do not reuse OPS_* tokens.
# When unset, only allowlisted ops work; freeform asks for this key.
CURSOR_API_KEY=
CURSOR_AGENT_REPOSITORY_URL=https://github.com/joshuaosborn561-lang/deliverabilitywizard
CURSOR_AGENT_STARTING_REF=main
CURSOR_AGENT_MODEL_ID=grok-4.5
CURSOR_AGENT_MODEL_PARAMS=effort=high,fast=true
CURSOR_AGENT_TIMEOUT_MS=480000

# Auto bug remediator (D21): repeated code-class failures → Cursor fix PR.
# Needs CURSOR_API_KEY. Never spends, deletes, or bypasses holds.
ENABLE_BUG_REMEDIATOR=true
BUG_REMEDIATOR_MIN_HITS=2
BUG_REMEDIATOR_COOLDOWN_HOURS=24
# Default off (D41): Cayden's Cursor account cannot merge. Josh may set true
# only if the Cursor API key is his.
BUG_REMEDIATOR_AUTO_MERGE=false

# Set true to plan remediation without applying Smartlead/InboxKit writes
DRY_RUN=false
