# Values here mirror the shipped defaults in src/config.ts as of the canon
# rebuild (D127). Rules live in CANON.md — when this file and CANON.md
# disagree, CANON.md wins and this file has a bug.

# Required — Smartlead core API (server.smartlead.ai)
SMARTLEAD_API_KEY=

# Optional — if different from SMARTLEAD_API_KEY (otherwise same key is used)
SMARTDELIVERY_API_KEY=

# Slack — use either an incoming webhook OR a bot token + channel id.
# Slack posts only: burned domain, isolated spam word, EOD scoreboard,
# and action results (D71).
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_CHANNEL=#deliverability
SLACK_SIGNING_SECRET=
SLACK_JOSH_USER_ID=
SLACK_CAYDEN_USER_ID=

# InboxKit — mailbox buys/cancels; pool zones live in InboxKit's Cloudflare
INBOXKIT_API_KEY=
INBOXKIT_WORKSPACE_ID=
# Dedicated workspace for the generic pool mailboxes
GENERIC_POOL_WORKSPACE_ID=81e7f800-4203-4892-a40d-18648b89b90c

# Self-advancing pool pipeline (polls every 30m by default)
ENABLE_POOL_PROVISIONER=true
CRON_POOL_PROVISION=*/30 * * * *

# Spend approval stays ON (D4/D15): purchases are held pending and a human
# approves via /approvals. Client spend is hard-capped $25 domains /
# 25 mailboxes per month.
REQUIRE_SPEND_APPROVAL=true
CLIENT_DOMAIN_BUDGET_USD=25
CLIENT_MAILBOX_MONTHLY_CAP=25
# One-time InboxKit→Smartlead login (NOT the API key)
SMARTLEAD_LOGIN_EMAIL=
SMARTLEAD_LOGIN_PASSWORD=

# Reconnect disconnected mailboxes: every health pass + daily 3am ET (D94)
ENABLE_ACCOUNT_RECONNECT=true
CRON_ACCOUNT_RECONNECT=0 3 * * *

# D105 — the 21-day warmup gate is ON: a mailbox that has not served 21 days
# from its InboxKit import is pulled off ACTIVE campaigns on the health pass.
# Pre-warmed fleets and the canary fleet are exempt.
ENABLE_WARMUP_GATE=true
MIN_CAMPAIGN_WARMUP_DAYS=21
POOL_WARMUP_DAYS=21
ENABLE_LEGACY_MAILBOX_PULLS=false

# Dedicated unwarmed canary fleet (D54/D55/D83): bought boxes, warmup always
# off, never staffing supply, send campaign copy in SmartDelivery tests only.
ENABLE_COPY_CANARY=true
COPY_CANARY_PER_CAMPAIGN=3

# Porkbun — parent-account domain buys for replacements / pool domains
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# SmartDelivery placement tests: recurring, unlimited (D45). 0 = unlimited.
TOTAL_TEST_QUOTA=0
# Max sender mailboxes per placement test (SmartDelivery API limit is 50)
MAX_MAILBOXES_PER_TEST=50
AUTO_PLACEMENT_TESTS=true
PLACEMENT_TEST_EVERY_DAYS=1
PLACEMENT_TEST_END_DAYS=0
AUTO_TEST_ACTIVE_STATUSES=ACTIVE
ENABLE_TEST_RECONCILER=true

# D32 — placement readings use same-ESP % only, never the blended score.
# 80 is a READING (logs / isolation), not a pull; pulls are kill-only (D51).
SCORE_SAME_ESP_ONLY=true
MIN_SAME_ESP_SAMPLES=3
REMEDIATION_INBOX_THRESHOLD=80
# D106 — a new campaign does not auto-START below this same-ESP % (promo=miss)
LAUNCH_INBOX_THRESHOLD=85

# The rotation engine is deleted (D51/D79/D130), not switched off — there
# are no flags for it. Readings below are logs / burn-checklist
# corroboration, never pull triggers.
BOUNCE_RATE_THRESHOLD=5
MIN_BOUNCE_SAMPLE=50

# D90 — the only live bounce rule: pause an ACTIVE campaign at >10% lifetime
# bounce with >=1000 leads emailed, or >10 new bounces in a 10-minute window.
# Smartlead's own autopause is converged to 100 (off) on drift (D80/D124).
ENABLE_CAMPAIGN_BOUNCE_AUTOSTOP=true
CRON_BOUNCE_AUTOSTOP=*/10 * * * *
BOUNCE_PAUSE_MIN_LEADS=1000
BOUNCE_PAUSE_RATE_PERCENT=10
BOUNCE_BURST_COUNT=10
ENABLE_BOUNCE_AUTOPAUSE_CONVERGE=true
SMARTLEAD_BOUNCE_AUTOPAUSE_OFF_PERCENT=100

# Staffing (D58/D82/D99): the floor is HALF that client's own staffable
# inboxes — computed per client, no global number. Generics staff only a POC
# client or a Josh-approved backfill (D81/D82).
ENABLE_CAMPAIGN_TOP_UP=true
ENABLE_CAMPAIGN_HEALTH=true
CRON_HEALTH=*/15 * * * *
POC_CLIENT_NAME_PATTERNS=goliath
CAMPAIGN_ESP_MIX_MIN_PERCENT=30
TOP_UP_EXCLUDE_CAMPAIGNS=

# Campaign checks (D81/D82): first-check new campaigns, then hourly sweep
ENABLE_CAMPAIGN_CHECK=true
CRON_CAMPAIGN_CHECK=0 * * * *

# Rest (D43): per-client even A/B split; off-week comes off live campaigns;
# generics rest after ~14 days of live send on their own clock.
ENABLE_CLIENT_REST=true
ENABLE_GENERIC_SEND_REST=true
GENERIC_SEND_REST_DAYS=14

# Pod-control known-good tests on the paused shell (D48/D56)
ENABLE_POD_CONTROLS=true
POD_CONTROL_SHELL_CAMPAIGN_ID=0

# Lead runout logs at 1/2, 3/4, done; never imports (D52). IP census (D53).
ENABLE_LEAD_RUNOUT=true
ENABLE_SENDING_INFRA_CENSUS=true

# Mailbox converge (D24/D30/D31/D35): 30/day (warmups excluded), 10-minute
# gap, two-line signature; warmup ON except the canary fleet (D83).
ENFORCE_MAILBOX_SETTINGS=true
MESSAGE_PER_DAY=30
MAILBOX_MIN_TIME_GAP_MINS=10
WARMUP_TOTAL_PER_DAY=20
WARMUP_DAILY_RAMPUP=5
WARMUP_REPLY_RATE_PERCENTAGE=30

# Pre-warmed inventory (D19): whole fleets by domain, plus from-name fleets.
EXTRA_GENERIC_MAILBOXES=harmony norris,breanna escobar
EXTRA_GENERIC_DOMAINS=crosslaunchco.com,crossscaleco.com,cleartechco.com

# Isolation rig (D48/D49) — word-deletion tests run on a dedicated low-rep
# domain that never touches campaigns. Unset = the word hunt cannot run.
ISOLATION_DOMAIN=
ISOLATION_BUY_PARENT_DOMAIN=crosslaunchco.com

# Campaign statuses considered for new tests
CAMPAIGN_STATUSES=ACTIVE,PAUSED

# Crons: twice-weekly scan; 6-hour measure loop (placement, DNS, adopt)
CRON_SCAN=0 9 * * 1,4
CRON_MONITOR=0 */6 * * *

# Optional: seed provider ids / sequence step for placement tests
PROVIDER_IDS=
SEQUENCE_NUMBER=1

# Persist state here (mount a Railway volume at /data in production)
STATE_FILE_PATH=/data/state.json

# HTTP
PORT=3000
HOST=0.0.0.0

# Required shared secret for /status, /run and /approvals/* (X-Run-Token).
RUN_TOKEN=

# Private employee console at /ops (owner/operator roles, audit log)
OPS_UI_ENABLED=true
OPS_OWNER_USERNAME=josh
OPS_OPERATOR_USERNAME=cayden
OPS_OWNER_TOKEN=
OPS_OPERATOR_TOKEN=
OPS_SESSION_SECRET=
OPS_SESSION_HOURS=12

# Freeform /ops chat → Cursor Cloud Agent (D20)
CURSOR_API_KEY=
CURSOR_AGENT_REPOSITORY_URL=https://github.com/joshuaosborn561-lang/deliverabilitywizard
CURSOR_AGENT_STARTING_REF=main
CURSOR_AGENT_MODEL_ID=grok-4.5
CURSOR_AGENT_MODEL_PARAMS=effort=high,fast=true
CURSOR_AGENT_TIMEOUT_MS=480000

# Auto bug remediator (D21). Auto-merge is OFF for the canon rebuild (D127).
ENABLE_BUG_REMEDIATOR=true
BUG_REMEDIATOR_MIN_HITS=2
BUG_REMEDIATOR_COOLDOWN_HOURS=24
BUG_REMEDIATOR_AUTO_MERGE=false

# Set true to plan without applying Smartlead/InboxKit writes
DRY_RUN=false
