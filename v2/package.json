{
  "name": "deliverability-wizard-v2",
  "version": "2.0.0",
  "description": "Parallel stripped wizard: api + staff + isolation workers, Postgres, shadow-by-default",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "migrate": "tsx src/migrate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pg": "^8.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
